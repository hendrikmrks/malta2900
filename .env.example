# Copy this file to `.env` and fill in your own values before running
# `docker compose up`. Never commit the real `.env` file.

# PostgreSQL credentials used by the `db` service.
POSTGRES_USER=malta
POSTGRES_PASSWORD=change_me
POSTGRES_DB=malta2900

# Must match the credentials above; used by `app` and `worker` to connect
# to the `db` service via Docker's internal network.
DATABASE_URL=postgresql://malta:change_me@db:5432/malta2900?schema=public

# Random secret used by NextAuth.js to sign session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me

# Public URL the app is served under (used by NextAuth for callbacks).
# For local development this is typically http://localhost:3900
NEXTAUTH_URL=http://localhost:3900
